# Materiais temporários de apresentação e configurações locais de outros agentes.
brag-output/
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/opsx/
!.claude/skills/
.claude/skills/*
!.claude/skills/openspec-*/

# O Impeccable baixa o binário adequado no primeiro uso.
.agents/skills/impeccable/scripts/bin/

# Arquivos locais comuns.
.DS_Store
node_modules/
tmp/
supabase/.temp/

# Configuração local pode conter chaves e tokens; o modelo documentado é
# `.env.example`, que permanece versionado sem valores reais.
.env
.env.*
!.env.example
