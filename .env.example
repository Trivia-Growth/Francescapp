# Configuração local do FFCMApp. Nunca preencha valores reais neste arquivo.
# Valores ausentes interrompem somente o fluxo dependente com erro público sanitizado.

# Cadastro e proxy Supabase (URL e chave anônima identificam o alvo; a chave é pública).
FFCM_SUPABASE_URL=
FFCM_SUPABASE_ANON_KEY=

# Auth nativo (D-14): origem first-party exata, sem caminho/query/fragmento.
# HTTPS na implantação; HTTP somente em localhost/127.0.0.1 explicitamente configurado.
FFCM_APP_ORIGIN=
# Ambas ausentes/desativadas por padrão; técnica exige as duas com valor true.
FFCM_AUTH_ATIVADO=
FFCM_AUTH_TECNICA_ATIVADO=
# Rotas de pacientes permanecem desativadas até a validação integrada.
FFCM_PACIENTES_ATIVADO=
FFCM_ANAMNESE_ATIVADA=
FFCM_PLANO_ATIVADO=
FFCM_EDICAO_PACIENTE_ATIVADA=
FFCM_CONTATO_ATIVADO=
FFCM_TAREFAS_ATIVADAS=
FFCM_TAREFAS_ESCRITA_ATIVADA=

# Cadastro nativo: IDs e referências de segredos já existentes no Vault.
# Referências de cifra usam pares id=referência separados por vírgula.
FFCM_VAULT_CIFRA_KEY_ID=
FFCM_VAULT_ATESTADO_KEY_ID=
FFCM_VAULT_CIFRA_REFERENCIAS=
FFCM_VAULT_HMAC_REFERENCIA=

# Conexão server-only ao banco com acesso restrito ao cofre; CA em PEM.
FFCM_VAULT_DB_HOST=
FFCM_VAULT_DB_PORT=
FFCM_VAULT_DB_NAME=
FFCM_VAULT_DB_USER=
FFCM_VAULT_DB_PASSWORD=
FFCM_VAULT_DB_CA=

# Legado experimental: não necessário ao cliente Auth nativo.
# Chave base64url de no mínimo 32 bytes e origens exatas, separadas por vírgula.
FFCM_COOKIE_SEALING_KEY=
FFCM_ALLOWED_ORIGINS=

# Entrada da equipe pelo Google Workspace. Não substitui concessão local vigente.
FFCM_GOOGLE_OAUTH_CLIENT_ID=
FFCM_GOOGLE_WORKSPACE_DOMAIN=

# Integração futura de IA. Sua ausência não bloqueia cadastro, sessão ou autorização.
OPENROUTER_API_KEY=

# Reservadas para adapters server-only futuros. Não são consumidas nesta tarefa.
FFCM_SUPABASE_SERVICE_ROLE_KEY=
FFCM_VAULT_KEY_REFERENCE=
